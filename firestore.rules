rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function isOwner() { return signedIn() && request.auth.uid == resource.data.uid; }
  match /profiles/{uid} {
   allow read, write: if signedIn() && request.auth.uid == uid;
  }
  match /posts/{postId} {
   allow read: if signedIn();
   allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid','name','district','sector','topic','body','createdAt','likes']) && request.resource.data.body is string && request.resource.data.body.size() <= 2500;
   allow update: if isOwner() && request.resource.data.uid == resource.data.uid;
   allow delete: if isOwner();
   match /comments/{commentId} {
    allow read: if signedIn();
    allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid','name','body','createdAt']) && request.resource.data.body is string && request.resource.data.body.size() <= 800;
    allow update, delete: if isOwner();
   }
  }
 }
}
